     "TO TALK.\""
    ]
   },
   "end": 124.82
  },
  {
   "id": "t3",
   "start": 124.82,
   "line": "Why does not knowing feel worse than bad news?",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": "",
   "params": {
    "short": "S06",
    "title": [
     "\"HEY. WE NEED",
     "TO TALK.\""
    ]
   },
   "end": 128.03
  },
  {
   "id": "t4",
   "start": 128.03,
   "line": "In one study, people were more stressed when they couldn't predict a small electric shock than when they knew it was coming.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": "",
   "params": {
    "short": "S06",
    "title": [
     "\"HEY. WE NEED",
     "TO TALK.\""
    ]
   },
   "end": 134.67
  },
  {
   "id": "t5",
   "start": 134.67,
   "line": "Uncertainty itself is stressful.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": "",
   "params": {
    "short": "S06",
    "title": [
     "\"HEY. WE NEED",
     "TO TALK.\""
    ]
   },
   "end": 137.04
  },
  {
