     "IN 2 SECONDS?"
    ]
   },
   "end": 33.61
  },
  {
   "id": "n5",
   "start": 33.61,
   "line": "while you wait for your turn to speak, your brain is busy planning what to say,",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": "",
   "params": {
