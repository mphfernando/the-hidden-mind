  },
  {
   "id": "d1",
   "start": 47.2,
   "line": "You walk into the kitchen. And you have no idea why you're there.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "fade",
    "dur": 0.25
   },
   "sfx": [],
   "notes": "",
   "params": {
    "short": "S03",
    "title": [
     "WHY DID I",
     "COME IN HERE?"
    ]
   },
   "end": 51.07
  },
  {
   "id": "d2",
   "start": 51.07,
   "line": "Your brain didn't break. Researchers found that walking through a doorway can make people forget more than staying in the same room.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [
    {
     "at": 0.05,
     "name": "pop",
     "gain": -18
    }
   ],
   "notes": "",
   "params": {
    "short": "S03",
    "title": [
     "WHY DID I",
     "COME IN HERE?"
    ]
   },
   "end": 58.28
  },
  {
   "id": "d3",
   "start": 58.28,
   "line": "A doorway works like an event boundary:",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": "",
   "params": {
    "short": "S03",
    "title": [
     "WHY DID I",
     "COME IN HERE?"
    ]
   },
   "end": 60.66
  },
  {
   "id": "d4",
   "start": 60.66,
   "line": "your brain files the last scene away and starts a new one.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": "",
   "params": {
    "short": "S03",
    "title": [
     "WHY DID I",
     "COME IN HERE?"
    ]
   },
   "end": 64.44
  },
  {
   "id": "d5",
   "start": 64.44,
   "line": "Send this to the friend who stands in front of the open fridge.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
