     "IN 2 SECONDS?"
    ]
   },
   "end": 30.5
  },
  {
   "id": "n4",
   "start": 30.5,
   "line": "Psychologists call it the next-in-line effect:",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
