     "TO TALK.\""
    ]
   },
   "end": 122.64
  },
  {
   "id": "t2",
   "start": 122.64,
   "line": "And your heart is already racing.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [
    {
     "at": 0.05,
