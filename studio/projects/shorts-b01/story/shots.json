  },
  {
   "id": "t1",
   "start": 119.64,
   "line": "\"Hey. We need to talk.\" No context.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "fade",
    "dur": 0.25
   },
   "sfx": [],
