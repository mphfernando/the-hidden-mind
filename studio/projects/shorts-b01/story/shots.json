     "WHY YOUR VOICE",
     "SOUNDS WEIRD"
    ]
   },
   "end": 72.31
  },
  {
   "id": "v2",
   "start": 72.31,
   "line": "And you think: that is not what I sound like.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [
    {
     "at": 0.05,
     "name": "pop",
     "gain": -18
    }
   ],
   "notes": "",
   "params": {
    "short": "S04",
    "title": [
     "WHY YOUR VOICE",
     "SOUNDS WEIRD"
    ]
   },
   "end": 75.33
  },
  {
   "id": "v3",
   "start": 75.33,
   "line": "But it is. When you talk, you hear yourself through the air and through the bones of your own skull,",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": "",
   "params": {
    "short": "S04",
    "title": [
     "WHY YOUR VOICE",
     "SOUNDS WEIRD"
    ]
   },
   "end": 81.4
  },
  {
   "id": "v4",
   "start": 81.4,
   "line": "which makes your voice sound deeper to you.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": "",
   "params": {
    "short": "S04",
    "title": [
     "WHY YOUR VOICE",
     "SOUNDS WEIRD"
    ]
   },
   "end": 83.87
  },
  {
   "id": "v5",
   "start": 83.87,
   "line": "A recording only catches the air.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": "",
   "params": {
    "short": "S04",
    "title": [
     "WHY YOUR VOICE",
     "SOUNDS WEIRD"
    ]
   },
   "end": 86.23
  },
  {
   "id": "v6",
   "start": 86.23,
   "line": "So the voice everyone knows… is the one you've never heard.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [],
   "notes": "",
   "params": {
    "short": "S04",
    "title": [
     "WHY YOUR VOICE",
     "SOUNDS WEIRD"
    ]
   },
   "end": 90.22
  },
  {
