    ]
   },
   "end": 70.31
  },
  {
   "id": "v1",
   "start": 70.31,
   "line": "You hear a recording of your own voice.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "fade",
    "dur": 0.25
   },
   "sfx": [],
   "notes": "",
   "params": {
