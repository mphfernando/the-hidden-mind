     "COME IN HERE?"
    ]
   },
   "end": 67.63
  },
  {
   "id": "d6",
   "start": 67.63,
   "line": "Now… why did you open this video?",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
