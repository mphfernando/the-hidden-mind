   },
   "end": 24.95
  },
  {
   "id": "n2",
   "start": 24.95,
   "line": "And her name is already gone. Two seconds.",
   "scene": "",
   "set": "v",
   "bars": null,
   "in": {
    "type": "cut"
   },
   "sfx": [
    {
     "at": 0.05,
